---
import BaseLayout from "../../layouts/BaseLayout.astro";
import caseStudies from "../../data/caseStudies.json";

export const prerender = true;

export function getStaticPaths() {
  return ["09labs", "kanso", "monolith", "quality-lab"].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const study = caseStudies[slug as keyof typeof caseStudies];
---

<BaseLayout title={`${study.title} case study`} description={study.summary}>
  <main class="case-page">
    <a class="back" href="/#labs-section">← Back to Labs</a>

    <p class="status">{study.status}</p>
    <h1>{study.title}</h1>
    <p class="summary">{study.summary}</p>

    {study.tags.length > 0 && (
      <ul class="tags" aria-label="Technologies">
        {study.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}

    {study.image && <img class="hero" src={study.image} alt="" width="1672" height="941" />}

    <div class="links">
      {study.githubUrl && (
        <a class="icon-btn" href={study.githubUrl} target="_blank" rel="noopener" aria-label="View code on GitHub" title="View code on GitHub">
          <img src="/github-blue.svg" alt="" width="18" height="18" aria-hidden="true" />
        </a>
      )}
      {study.websiteUrl && (
        <a class="icon-btn" href={study.websiteUrl} target="_blank" rel="noopener" aria-label="Open live project" title="Open live project">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>
      )}
    </div>

    {study.sections.map((section) => (
      <section class="section">
        <h2>{section.heading}</h2>
        {section.body.split("\n\n").map((para) => <p>{para}</p>)}
      </section>
    ))}

    {study.gallery && (
      <div class="gallery">
        {study.gallery.map((src) => (
          <img src={src} alt="" width="1672" height="941" loading="lazy" />
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .case-page {
    max-width: 46rem;
    margin: 0 auto;
    padding: 6rem 1.25rem 4rem;
    line-height: 1.7;
  }
  .back { color: #2a52cc; text-decoration: none; font-size: 0.9rem; }
  .status {
    margin: 2rem 0 0.5rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #2a52cc;
  }
  h1 { font-family: "Space Grotesk", sans-serif; font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.75rem; }
  .summary { font-size: 1.1rem; margin: 0 0 1.5rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .tags li { border: 1px solid #7a879a; border-radius: 4px; padding: 0.3rem 0.6rem; font-family: "Azeret Mono", monospace; font-size: 0.8rem; }
  .hero { width: 100%; height: auto; border-radius: 6px; margin-bottom: 1.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem; }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #6a9eff;
    background: #0a0e17;
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    text-decoration: none;
  }
  .icon-btn:hover,
  .icon-btn:focus-visible { border-color: #6a9eff; }
  .section { margin-top: 2rem; }
  .section h2 { font-family: "Space Grotesk", sans-serif; font-size: 1.3rem; margin: 0 0 0.5rem; }
  .section p { margin: 0 0 0.9rem; }
  :global(.dark) .status,
  :global(.dark) .back,
  :global(.dark) .links a { color: #6a9eff; }
  .gallery {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid rgba(106, 158, 255, 0.25);
  }
</style>
