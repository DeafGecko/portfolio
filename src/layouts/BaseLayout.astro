---
import Header from "../components/Header.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean; // ← new prop
}
const {
  title,
  description = "Dwight Rogers builds clear, useful apps with design and code: booking tools, writing apps, shopping flows and accessible communication apps.",
  hideHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · 09 Folio</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 09 Folio`} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />

    <!-- Fonts: preconnect + non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=Azeret+Mono:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=Azeret+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=Azeret+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Dynamic theme-color for mobile browsers -->
    <meta name="theme-color" id="theme-color" content="#0a0e17" />

    <!-- Default to dark mode while preserving an explicit saved preference -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("09labs-theme");
        const theme = storedTheme === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.querySelector('meta[name="theme-color"]').content =
          theme === "dark" ? "#0a0e17" : "#dfe2e3";
      })();
    </script>

    <!-- Smooth transitions (global) -->
    <style is:global>
      * {
        transition:
          background-color 0.2s ease-in-out,
          border-color 0.2s ease-in-out,
          color 0.2s ease-in-out;
      }
    </style>
  </head>
  <body
    class="bg-[#dfe2e3] dark:bg-[#0a0e17] text-[#4a5059] dark:text-[#eef4ff] font-sans antialiased"
  >
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Intro splash: logo, then the name types out, then the page fades in (once per session) -->
    <div class="intro-splash" id="introSplash" aria-hidden="true">
      <div class="intro-inner">
        <img class="intro-logo" src="/brand/09-folio-logo.svg" alt="" width="220" height="220" />
        <p class="intro-type">
          <span class="intro-text" id="introText"></span><span class="intro-caret"></span>
        </p>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById("introSplash");
        if (!el) return;
        var seen = false;
        try {
          seen = sessionStorage.getItem("introSeen") === "1";
          sessionStorage.setItem("introSeen", "1");
        } catch (e) {}
        if (seen || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          el.remove();
          return;
        }
        var out = document.getElementById("introText");
        var name = "09 Folio";
        var i = 0;
        function typeNext() {
          if (i > name.length) return;
          var num = name.slice(0, Math.min(i, 2));
          var rest = i > 2 ? name.slice(2, i) : "";
          out.innerHTML =
            '<span class="intro-num">' + num + "</span>" +
            (rest ? '<span class="intro-name">' + rest + "</span>" : "");
          i++;
          setTimeout(typeNext, 120);
        }
        setTimeout(typeNext, 1200);
        setTimeout(function () { el.classList.add("is-done"); }, 3900);
        setTimeout(function () { el.remove(); }, 4900);
      })();
    </script>

    <!-- aria-live region for screen readers -->
    <div id="announcer" aria-live="polite" class="sr-only"></div>

    <!-- Main Header (skip if hideHeader is true) -->
    {!hideHeader && <Header />}

    <!-- Page content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <script is:inline>
      (() => {
        let animationFrame;
        let restoreScrollBehavior;

        document.addEventListener("click", (event) => {
          const link = event.target.closest('a[href^="#"]');
          if (!link || link.classList.contains("skip-link")) return;

          const hash = link.getAttribute("href");
          const target = hash && document.querySelector(hash);
          if (!target) return;

          event.preventDefault();
          cancelAnimationFrame(animationFrame);
          restoreScrollBehavior?.();

          const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          const start = window.scrollY;
          const headerOffset = hash === "#hero-section" ? 0 : 80;
          const destination = Math.max(
            0,
            target.getBoundingClientRect().top + start - headerOffset,
          );

          history.pushState(null, "", hash);

          if (reduceMotion) {
            window.scrollTo(0, destination);
            return;
          }

          const root = document.documentElement;
          const previousScrollBehavior = root.style.scrollBehavior;
          root.style.scrollBehavior = "auto";
          restoreScrollBehavior = () => {
            root.style.scrollBehavior = previousScrollBehavior;
            restoreScrollBehavior = undefined;
          };

          const distance = destination - start;
          const startedAt = performance.now();
          const duration = 900;

          const step = (time) => {
            const progress = Math.min((time - startedAt) / duration, 1);
            const eased =
              progress < 0.5
                ? 4 * progress * progress * progress
                : 1 - Math.pow(-2 * progress + 2, 3) / 2;

            window.scrollTo(0, start + distance * eased);

            if (progress < 1) {
              animationFrame = requestAnimationFrame(step);
            } else {
              restoreScrollBehavior();
            }
          };

          animationFrame = requestAnimationFrame(step);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    overscroll-behavior-y: none;
    background-color: #dfe2e3 !important;
    transition: none;
  }

  html.dark {
    background-color: #0a0e17 !important;
  }

  body {
    min-height: 100vh;
    overscroll-behavior-y: none;
    overflow-x: clip;
    background-color: #dfe2e3 !important;
    transition: none;
  }

  html.dark body {
    background-color: #0a0e17 !important;
  }

  #works-section,
  #techstack-section,
  #experience-section,
  #contact-section {
    --blueprint-edge: clamp(18px, 3.5vmin, 32px);
    position: relative;
  }

  #works-section::before,
  #techstack-section::before,
  #experience-section::before,
  #contact-section::before {
    content: "";
    position: absolute;
    z-index: 3;
    inset: 0 var(--blueprint-edge);
    border-inline: 1px dashed rgba(100, 120, 180, 0.14);
    pointer-events: none;
  }

  .dark #works-section::before,
  .dark #techstack-section::before,
  .dark #experience-section::before,
  .dark #contact-section::before {
    border-inline-color: rgba(100, 180, 255, 0.12);
  }

  #works-section .slice,
  #techstack-section .tech-card,
  #experience-section .experience-item {
    transform: perspective(900px) rotateX(var(--motion-tilt-x, 0deg))
      rotateY(var(--motion-tilt-y, 0deg)) scale(var(--motion-scale, 1));
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    color: #ffffff;
    background: #1a3aaa;
    border: 2px solid #ffffff;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  :focus-visible {
    outline: 2px solid #5a8eff;
    outline-offset: 3px;
  }

  #hero-section,
  #works-section,
  #techstack-section {
    scroll-margin-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto !important;
    }
  }
</style>

<style is:global>
  .intro-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dfe2e3;
    transition:
      opacity 1s ease-in-out,
      visibility 0s linear 1s;
  }

  .dark .intro-splash {
    background: #0a0e17;
  }

  .intro-splash.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .intro-type {
    display: flex;
    align-items: center;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #343b45;
    min-height: 1em;
  }

  .dark .intro-type {
    color: #eef4ff;
  }

  /* same colors as the header wordmark */
  .intro-num {
    color: #2a52cc;
  }

  .dark .intro-num {
    color: #5a8eff;
  }

  .intro-name {
    color: #343b45;
  }

  .dark .intro-name {
    color: #eef4ff;
  }

  .intro-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 0.12em;
    background: #2a52cc;
    animation: intro-blink 1s steps(1) infinite;
  }

  .dark .intro-caret {
    background: #6a9eff;
  }

  @keyframes intro-blink {
    50% {
      opacity: 0;
    }
  }

  .intro-splash.is-done .intro-type {
    animation: intro-out 1s ease-in-out both;
  }

.intro-logo {
    width: clamp(140px, 24vw, 220px);
    height: clamp(140px, 24vw, 220px);
    animation: intro-in 2.2s ease-in-out both;
  }

  .intro-splash.is-done .intro-logo {
    animation: intro-out 1s ease-in-out both;
  }

  @keyframes intro-out {
    from {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
    to {
      opacity: 0;
      transform: scale(1.04);
      filter: blur(8px);
    }
  }

  @keyframes intro-in {
    from {
      opacity: 0;
      transform: scale(0.94);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-logo {
      animation: none;
    }
  }
</style>
