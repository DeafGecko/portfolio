---
const { base = "" } = Astro.props;
---

<nav aria-label="Main navigation" class="hidden md:flex items-center space-x-8">
  <a
    href={`${base}#works-section`}
    class="relative text-sm font-medium
                  text-[#4a5059] dark:text-gray-300
                  hover:text-[#2a52cc] dark:hover:text-[#6a9eff]
                  transition-colors duration-200
                  pb-1
                  after:absolute after:left-0 after:bottom-0
                  after:h-0.5 after:w-0
                  after:bg-[#2a52cc] dark:after:bg-[#6a9eff]
                  after:transition-all after:duration-300
                  hover:after:w-full"
  >
    Work
  </a>
  <a
    href={`${base}#techstack-section`}
    class="relative text-sm font-medium
                  text-[#4a5059] dark:text-gray-300
                  hover:text-[#2a52cc] dark:hover:text-[#6a9eff]
                  transition-colors duration-200
                  pb-1
                  after:absolute after:left-0 after:bottom-0
                  after:h-0.5 after:w-0
                  after:bg-[#2a52cc] dark:after:bg-[#6a9eff]
                  after:transition-all after:duration-300
                  hover:after:w-full"
  >
    Skills
  </a>
  <a
    href={`${base}#experience-section`}
    class="relative text-sm font-medium
                  text-[#4a5059] dark:text-gray-300
                  hover:text-[#2a52cc] dark:hover:text-[#6a9eff]
                  transition-colors duration-200
                  pb-1
                  after:absolute after:left-0 after:bottom-0
                  after:h-0.5 after:w-0
                  after:bg-[#2a52cc] dark:after:bg-[#6a9eff]
                  after:transition-all after:duration-300
                  hover:after:w-full"
  >
    Experience
  </a>
  <a
    href={`${base}#contact-section`}
    class="relative text-sm font-medium
                  text-[#4a5059] dark:text-gray-300
                  hover:text-[#2a52cc] dark:hover:text-[#6a9eff]
                  transition-colors duration-200
                  pb-1
                  after:absolute after:left-0 after:bottom-0
                  after:h-0.5 after:w-0
                  after:bg-[#2a52cc] dark:after:bg-[#6a9eff]
                  after:transition-all after:duration-300
                  hover:after:w-full"
  >
    Contact
  </a>
</nav>
