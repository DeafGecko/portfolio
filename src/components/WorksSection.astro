  html:not(.dark) .slice-summary {
    color: rgba(52, 59, 69, 0.78);
  }

  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-number,
  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-vertical-name,
  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-eyebrow,
  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-title,
  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-summary,
  html:not(.dark) .slice:has(.slice-bg.has-image) .tag,
  html:not(.dark) .slice:has(.slice-bg.has-image) .project-link {
    color: #ffffff;
  }

  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-number,
  html:not(.dark) .slice:has(.slice-bg.has-image) .project-link {
    background: rgba(10, 14, 23, 0.72);
    border-color: rgba(255, 255, 255, 0.42);
  }

  html:not(.dark) .slice:has(.pattern-folio) .slice-number {
    color: #ffffff;
    background: rgba(10, 14, 23, 0.72);
    border-color: rgba(255, 255, 255, 0.42);
  }

  html:not(.dark) .slice:has(.slice-bg.has-image) .slice-tags {
    border-top-color: rgba(255, 255, 255, 0.28);
  }

  html:not(.dark) .slice:has(.slice-bg.has-image) .tag {
    border-color: rgba(255, 255, 255, 0.38);
  }

  html:not(.dark) .slice:has(.slice-bg.has-image) .project-link-icon {
    filter: brightness(0) invert(1);
  }

  .slice.is-active .slice-summary {
    opacity: 1;
    transform: translateY(0);
  }

  /* collapsed-state label: rotated eyebrow only, no tags/badge */
  .slice:not(.is-active) .slice-title {
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .works {
      padding: calc(1.25rem + 10px) 1.4rem 4.5rem;
    }
    .works-header {
      align-items: flex-start;
    }
    .works-hint {
      text-align: left;
      max-width: 100%;
    }
    .works-accordion {
      flex-direction: column;
      height: auto;
      min-height: 0;
      overflow-x: visible;
    }
    .slice {
      flex: 0 0 64px;
      width: 100%;
      height: auto;
      transition: flex-basis 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .slice.is-active {
      flex: 0 0 min(70vh, 420px);
    }
    .slice-content {
      white-space: normal;
      right: 1.1rem;
    }
    .slice-vertical-label {
      inset: 0;
      align-items: flex-start;
      justify-content: flex-start;
      padding: 1rem 1.1rem;
    }
    .slice-vertical-name {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slice,
    .slice-bg,
    .slice-badge,
    .slice-eyebrow,
    .slice-tags {
      transition-duration: 0.01ms !important;
    }
    .slice-links {
      transition-duration: 0.01ms !important;
    }
  }

  /* Every project stays readable without hover or JavaScript. */
  .works .works-accordion { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); height: auto; gap: 1.5rem; padding: 0; border: 0; background: transparent; }
  .works .slice, .works .slice.is-active { height: auto; min-width: 0; cursor: default; background: #202b3c; }
  .works .slice-bg, .works .slice.is-active .slice-bg { position: relative; inset: auto; width: 100%; height: auto; aspect-ratio: 16 / 10; opacity: 1; filter: none; transform: none; background-size: cover; background-position: top center; }
  .works .slice-overlay, .works .slice-vertical-label, .works .slice-cue, .works .slice-topline { display: none; }
  .works .slice-content, .works .slice.is-active .slice-content { position: relative; inset: auto; padding: 1.5rem; opacity: 1; visibility: visible; pointer-events: auto; }
  .works .slice-title, .works .slice.is-active .slice-title { font-size: 1.65rem; color: #eef4ff; }
  .works .slice-summary, .works .slice.is-active .slice-summary { max-width: none; color: #d0dcef; opacity: 1; transform: none; }
  .works .slice-eyebrow, .works .slice.is-active .slice-eyebrow { color: #a8c8ff; }
  .works .slice-tags, .works .slice.is-active .slice-tags { max-height: none; overflow: visible; }
  .works .slice-tags, .works .slice.is-active .slice-tags, .works .slice-links, .works .slice.is-active .slice-links { opacity: 1; transform: none; pointer-events: auto; }
  .works .slice .tag { color: #d0dcef; }
  .works .slice .project-link { color: #eef4ff; }
  .works .slice .project-link-icon { filter: brightness(0) invert(1); }
  /* cards keep dark bodies in both themes, so links stay dark with light text */
  .works .slice .project-link, .works .slice .project-case-study, html:not(.dark) .works .slice .project-link { background: #0a0e17; color: #eef4ff; border-color: rgba(106, 158, 255, 0.35); }
  .works .slice .project-link-icon, html:not(.dark) .works .slice .project-link-icon { filter: brightness(0) invert(1); }
  .works .pattern-vantge { background: radial-gradient(circle at 70% 30%, #c4ad65, transparent 50%), linear-gradient(135deg, #f4f0e5, #817143); }
  @media(max-width: 720px) { .works .works-accordion { grid-template-columns: 1fr; } }
  .project-link-lab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .project-link-lab-icon {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    margin: auto;
    border-radius: 4px;
  }
  /* short label that pops out above the card buttons on hover or keyboard focus */
  .project-link[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    background: #0a0e17;
    color: #eef4ff;
    border: 1px solid rgba(106, 158, 255, 0.35);
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .project-link[data-tip]:hover::after,
  .project-link[data-tip]:focus-visible::after {
    opacity: 1;
  }
  /* the card image opens the live project */
  .slice-image-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 16 / 10;
    z-index: 1;
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    function initWorksAccordion() {
      const accordion = document.getElementById("worksAccordion");
      if (!accordion || accordion.dataset.wired === "true") return;
      accordion.dataset.wired = "true";

      const modal = document.getElementById("caseStudyModal");
      const closeButton = modal?.querySelector("[data-case-study-close]");
      const title = document.getElementById("caseStudyTitle");
      const eyebrow = document.getElementById("caseStudyEyebrow");
      const summary = document.getElementById("caseStudySummary");
      const body = document.getElementById("caseStudyBody");
      const gallery = document.getElementById("caseStudyGallery");
      const tags = document.getElementById("caseStudyTags");
      const github = document.getElementById("caseStudyGithub");
      const githubNote = document.getElementById("caseStudyGithubNote");
      const website = document.getElementById("caseStudyWebsite");
      const website2 = document.getElementById("caseStudyWebsite2");
      const statusBadge = document.getElementById("caseStudyStatus");
      let trigger = null;

      function setModalLink(link, url) {
        if (!link) return;
        link.hidden = !url;
        if (url) link.setAttribute("href", url);
        else link.removeAttribute("href");
      }

      accordion
        .querySelectorAll("[data-case-study-trigger]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            if (!modal) return;
            trigger = button;
            title.textContent = button.dataset.title;
            eyebrow.textContent = button.dataset.eyebrow;

            // rich sections
            const sections = JSON.parse(
              button.dataset.caseStudySections || "[]",
            );
            if (sections.length > 0) {
              body.replaceChildren();
              sections.forEach(({ heading, body: text }) => {
                const sec = document.createElement("div");
                sec.className = "cs-section";
                const h = document.createElement("h4");
                h.className = "cs-section-heading";
                h.textContent = heading;
                sec.append(h);
                String(text)
                  .split(/\n{2,}/)
                  .forEach((paragraph) => {
                    const p = document.createElement("p");
                    p.className = "cs-section-body";
                    paragraph.split("\n").forEach((line, index) => {
                      if (index > 0) p.append(document.createElement("br"));
                      if (/[✓+→]/.test(line)) {
                        const strong = document.createElement("strong");
                        strong.textContent = line;
                        p.append(strong);
                      } else {
                        p.append(line);
                      }
                    });
                    sec.append(p);
                  });
                body.append(sec);
              });
              body.hidden = false;
              summary.hidden = true;
            } else {
              summary.textContent = button.dataset.summary;
              summary.hidden = false;
              body.hidden = true;
            }

            // gallery
            const screenshots = JSON.parse(button.dataset.screenshots || "[]");
            if (screenshots.length > 0) {
              gallery.replaceChildren();
              screenshots.forEach(({ src, alt }) => {
                const img = document.createElement("img");
                img.src = src;
                img.alt = alt || "";
                img.className = "cs-screenshot";
                img.loading = "lazy";
                img.tabIndex = 0;
                gallery.append(img);
              });
              gallery.hidden = false;
            } else {
              gallery.hidden = true;
            }

            tags.replaceChildren();
            JSON.parse(button.dataset.tags || "[]").forEach((tag) => {
              const item = document.createElement("span");
              item.className = "case-study-tag";
              item.textContent = tag;
              tags.append(item);
            });

            // github: icon link vs. private note
            const note = button.dataset.githubNote || "";
            if (note) {
              github.hidden = true;
              githubNote.textContent = note;
              githubNote.hidden = false;
            } else {
              githubNote.hidden = true;
              setModalLink(github, button.dataset.githubUrl);
            }

            setModalLink(website, button.dataset.websiteUrl);
            setModalLink(website2, button.dataset.websiteUrl2);
            if (website2)
              website2.title =
                button.dataset.websiteUrl2Label || "Visit alternate site";

            // status badge
            const status = button.dataset.caseStudyStatus || "";
            if (statusBadge) {
              statusBadge.hidden = !status;
              statusBadge.textContent = status ? `Status: ${status}` : "";
            }

            modal.showModal();
            closeButton?.focus();
          });
        });

      closeButton?.addEventListener("click", () => modal?.close());
      modal?.addEventListener("click", (event) => {
        if (event.target === modal) modal.close();
      });
      modal?.addEventListener("close", () => trigger?.focus());
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWorksAccordion);
    } else {
      initWorksAccordion();
    }
  })();
</script>
