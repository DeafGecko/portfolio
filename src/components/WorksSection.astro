---
import { FileSearch } from "lucide-react";

export interface CaseStudySection {
  heading: string;
  body: string;
}

export interface WorkItem {
  eyebrow: string;
  title: string[];
  category: string;
  featured?: boolean;
  summary?: string;
  tags?: string[];
  /** reserved for future case study page — not yet implemented */
  caseStudyUrl?: string;
  githubUrl?: string;
  /** shown as text in the modal instead of an icon link (e.g. "Private — available on request") */
  githubNote?: string;
  websiteUrl?: string;
  websiteUrl2?: string;
  websiteUrl2Label?: string;
  /** optional real screenshot — falls back to a generated pattern */
  image?: string;
  /** rich case study sections rendered inside the modal */
  caseStudySections?: CaseStudySection[];
  /** status badge shown at the bottom of the case study (e.g. "In development") */
  caseStudyStatus?: string;
  /** up to 2 screenshots shown in the modal gallery */
  screenshots?: { src: string; alt: string }[];
}

export interface Props {
  heading?: string;
  hint?: string;
  works?: WorkItem[];
}

const {
  heading = "SELECTED WORKS",
  hint = "Explore working projects, design decisions, and what is still in development.",
  works = [
    {
      featured: true,
      eyebrow: "VENUE OPERATIONS PLATFORM",
      title: ["THE FACTORY"],
      category: "factory",
      image: "/images/factory-dashboard-laptop.png",
      screenshots: [
        { src: "/images/factory-dashboard-laptop.png", alt: "The Factory dashboard shown on a laptop" },
        { src: "/images/factory02.png", alt: "The Factory calendar view" },
      ],
      summary:
        "A demo booking and admin app for an event venue, built for my own practice. It covers bookings, payments and role-based access.",
      tags: [
        "Astro",
        "React",
        "TypeScript",
        "Tailwind CSS",
        "Cloudflare Workers",
        "D1",
        "Sanity",
      ],
      githubUrl: "https://github.com/DeafGecko/venue-operations",
      websiteUrl: "https://venue-operations-api.dwirog.workers.dev/admin/dashboard",
      caseStudyStatus: "Demo",
      caseStudySections: [
        {
          heading: "What it is",
          body: "A demo app for an event venue. I built it for myself to practice and to test ideas. It is not used by a real venue.\n\nIt has four staff roles: admin, manager, developer and viewer.",
        },
        {
          heading: "Why I built it",
          body: "Some venue software is too hard to use. I wanted something simpler, with one place to see events, make a booking, check the calendar and find a client.\n\nI also wanted a real project to learn Astro and practice full-stack work.",
        },
        {
          heading: "What I built",
          body: "A two-step booking form. It checks the name, email, phone number, date and guest count before it saves anything.\n\nA dashboard that shows money by month, money by event type and the next events.\n\nA calendar that shows whether each event is paid, partly paid or unpaid.\n\nRoles that limit what each person can change. A viewer cannot edit data, and the server enforces this, not only the screen.\n\nA public page with the dashboard and calendar in read-only form. Other pages need an access code.",
        },
        {
          heading: "Choices I made",
          body: "I used Astro because most pages only show data, and Astro keeps those pages small and fast. I used React only where a page needs interaction, like the forms, the calendar and the dialogs.\n\nCloudflare Workers runs the app. D1 is the database. Sanity stores the venue data.\n\nThe server builds each booking, so the form cannot change the price or the amount paid.\n\nIn testing, a fake cookie got into the admin area. I fixed it by signing sessions with HMAC. The tests sign cookies the same way the server checks them.",
        },
        {
          heading: "What I fixed after testing",
          body: "Fake cookie bug: fixed with signed sessions.\n\nSign-in worked on my computer but failed on Cloudflare. Secrets were not readable at runtime. I turned on runtime environment access, and it worked.\n\nLesson: working locally does not mean it will work in production.\n\nThe Lighthouse SEO score is 1.0 for the booking page and 0.58 for the homepage. The homepage leads to an admin page, and I hide admin pages from search engines on purpose. I wrote the descriptions and the robots.txt and sitemap.xml files so they come from one source.",
        },
        {
          heading: "Testing",
          body: "I wrote 19 unit tests with Vitest. They all pass.\n\nI ran browser tests with Playwright at desktop and phone sizes. The last full run had two failures. I fixed both and ran the tests again.",
        },
        {
          heading: "Still to do",
          body: "Color contrast still fails on many pages. I am fixing this now.\n\nInvite and password-reset emails do not send yet. They need an email service key.\n\nI deploy by hand with Wrangler, because automatic deploys from GitHub are not reliable yet.",
        },
      ],
      // Add up to 2 screenshot images below when ready:
      // screenshots: [
      //   { src: "/images/factory-screen-1.png", alt: "The Factory dashboard view" },
      //   { src: "/images/factory-screen-2.png", alt: "The Factory calendar view" },
      // ],
    },
    {
      eyebrow: "EVENT PHOTO SHARING",
      title: ["VANTGE"],
      category: "vantge",
      image: "/images/vantge-mockup.png",
      screenshots: [
        { src: "/images/vantge-mockup.png", alt: "Vantge event dashboard and phone guest page" },
      ],
      featured: true,
      summary:
        "A web app for hosting an event. A host shares a photo gallery and an invitation with guests through one link or QR code, and runs everything from one dashboard. I designed and built it, including a browser-only demo.",
      tags: ["Product Design", "Host & Guest Workflows", "Browser demo"],
      websiteUrl: "https://vantge.app/try",
      githubUrl: "https://github.com/DeafGecko/vantge",
      caseStudyStatus: "Live demo",
      caseStudySections: [
        {
          heading: "Summary",
          body: "Try the demo at vantge.app/try. The access code is Demo.\n\nVantge is a web app for hosting a party, wedding or other event. A host shares a photo gallery and an invitation with guests through one link or QR code, and runs everything from one dashboard.\n\nI designed and built the host dashboard, the guest pages, and a browser-only demo that lets a visitor try the dashboard without signing up.",
        },
        {
          heading: "The problem",
          body: "Hosts juggle several tools: one for guest photos, one for RSVPs, a separate place for food sign-up, and a QR code printed on a card. Guests have to remember several links. Hosts want to see a change the moment they make it, and they want the page to look like their event, not a template.\n\nVantge puts these in one event with one link. The host sets the look (name, event type, background photo, colors, title font), and the guest sees the result straight away.",
        },
        {
          heading: "Goals",
          body: "A host can create and style an event without help, on a phone or a laptop.\n\nThe live preview matches what guests see.\n\nA prospect can try the dashboard before signing up, without touching real data.\n\nThe layout works on a small laptop and on a large monitor.\n\nThe code passes automated accessibility, performance and layout checks.",
        },
        {
          heading: "What I built",
          body: "Host dashboard: a live preview that updates as the host types a name or picks a color, font or background, with mobile and desktop views. Each screen size gets its own background photo, portrait for phones and landscape for desktop, chosen from a gallery of default photos or uploaded. The host can also set the title font and color palette, move the title with a slider, and upload a logo.\n\nThe host can open or close the gallery, set a per-guest photo limit, add an optional passcode, and control guest options such as downloads, sharing and photo review before publishing. A queue holds guest uploads for approval, and a QR code links to the guest page.\n\nGuest pages: an event page with the same look as the preview, plus a photo upload and gallery view.\n\nBrowser-only demo (/try): a start page where a visitor enters an access code and names their event, then opens the dashboard with sample data. Edits stay in that browser. Reset restores the sample, and nothing is sent to the live database. A guest mobile page matches the dashboard preview, with a phone QR code and a phone-sized window for checking the mobile layout.\n\nRSVP: the RSVP dashboard, guest RSVP page and RSVP manager are finished, but they are moved to a sandbox folder while I rework them. They stay out of the live app and the build, so visitors are not affected.",
        },
        {
          heading: "Key decisions",
          body: "I kept the demo away from real data. It runs on an in-browser stand-in for the database, chosen by the page address on every call. Real event pages keep using the live database. This made the demo safe to share publicly and easy to reset.\n\nThe settings column is taller than a laptop screen, so a plain sticky element cannot show its bottom. I wrote a small scroll hook that keeps the preview beside the settings while the page scrolls, then lets it slide down so the last card can be reached. It updates only on scroll and resize, so the page does not jump.\n\nDashboard content sits in a 1024-pixel centered frame, sized for a small laptop. The header and background run the full window width.\n\nA demo sign-in leaked into the real sign-in flow when a visitor left the demo through an in-app link. The exit links now do full page loads, which clears the demo session. Testing found this.\n\nEach page now loads only when it is opened. The home page's main bundle dropped from about 930KB to about 225KB.",
        },
        {
          heading: "Testing",
          body: "Unit tests (Vitest): 2 test files and 6 tests, all passing. They cover the dropdown and the date and time field.\n\nBrowser and accessibility tests (Playwright with axe): 2 checks, one for the home page and one for the login page, both passing. They check for serious and critical accessibility problems after scrolling. Getting them to pass found 15 low-contrast text problems on the home page, which I fixed.\n\nLighthouse, mobile emulation, production build: the home page scores 88 to 96 for performance, 100 for accessibility, best practices and SEO. The demo event page scores 76 to 82 for performance and 100 for accessibility, best practices and SEO. Its largest paint went from about 8 seconds to about 4.8 seconds. The biggest gains came from loading pages on demand and hosting the sample photos with the site instead of an outside image service.\n\nLayout and smoke checks: a phone-width check on 5 pages at 360, 390 and 430 pixels passed in all 15 combinations, with no sideways scrolling. A demo smoke test covered the start page, the event dashboard, the gallery count and the guest page, with no page errors. I also checked the layout by hand at 1024, 1280, 1440, 1512, 1920 and 2560 pixels wide.\n\nCode quality: lint went from 64 problems to none with errors. The main fixes were removing unused code, moving data loading into cancelable effects, and moving one component out of a page so React does not rebuild it on every render. The smoke test caught one bug that lint missed, a removed name that was still in use. I restored it.",
        },
        {
          heading: "Results",
          body: "A demo visitor can go from the start page to a styled event dashboard in three steps.\n\nThe demo event page passes the accessibility, best practices and SEO checks at 100.\n\nChanges are on the main branch and deploy through Vercel.\n\nThe RSVP code is clean in its sandbox, but it is not yet back in the live app.\n\nI have not measured real visitor numbers, conversion or host feedback, so I do not claim any here.",
        },
        {
          heading: "Tech stack",
          body: "React 19, React Router 7, Vite and Tailwind CSS 4. Supabase for the live database, sign-in and file storage. qrcode.react for QR codes and lucide-react for icons. Vitest, Playwright with axe and Lighthouse for testing. Deployed on Vercel.",
        },
        {
          heading: "Next steps",
          body: "Try the demo at vantge.app/try with the access code Demo.\n\nBring the RSVP pages back into the app, with a shared sandbox backend so a phone and a laptop see the same changes in the demo.\n\nReduce the remaining JavaScript on the demo page, and host the rest of the event-type photos with the site.\n\nMeasure how long it takes a new host to create a styled event, with real users.",
        },
      ],
    },
    {
      featured: true,
      eyebrow: "VISUAL COMMUNICATION APP",
      title: ["SHOWCARD"],
      category: "clearcard",
      image: "/images/showcard-mockup.png",
      screenshots: [
        {
          src: "/images/showcard-mockup.png",
          alt: "ShowCard app on a phone and laptop",
        },
      ],
      summary:
        "A card-based communication app built for the Deaf and Hard of Hearing community — fast, visual, and accessible by design.",
      tags: ["React", "Visual Communication", "Accessibility"],
      githubUrl: "https://github.com/DeafGecko/clearcard",
      websiteUrl: "https://showcard.09labs.dev",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What I Built",
          body: "ShowCard is a visual communication app for Deaf and Hard of Hearing people.\n\nThe idea is simple:\n\nChoose a card → Show the message → Communicate\n\nIt is designed for situations where someone needs to communicate quickly without depending on sound.",
        },
        {
          heading: "Why I Built It",
          body: "I wanted communication to be simple, visual, and quick.\n\nInstead of making people read through many menus, I wanted them to find what they need and show it.\n\nSee → Tap → Show.",
        },
        {
          heading: "How I Built It",
          body: "I focused on making the cards clear and easy to understand.\n\nWhile building it, I kept asking:\n“Can someone understand this quickly?”\n\nThat helped me think more about the user instead of just adding features.",
        },
        {
          heading: "Tech I Used",
          body: "React + Card-Based UI\n\nI kept the interface simple with large visual cards and clear text.",
        },
        {
          heading: "Accessibility",
          body: "Accessibility is the main purpose of this project.\n\nI focused on:\n\n✓ Visual communication\n✓ Clear text\n✓ Easy-to-understand cards\n✓ Large tap areas\n✓ No need for sound",
        },
        {
          heading: "What I Learned",
          body: "This project taught me that simple design can be difficult.\n\nAdding more features is easy.\n\nMaking something clear, fast, and easy to understand takes more thought.",
        },
        {
          heading: "What's Next",
          body: "I have two ideas I want to add:\n\nQuick Card — quickly type something that is not already available as a card.\n\nHistory — look back at messages used during a conversation.\n\nI also plan to improve the design and turn it into a PWA so it can feel more like an installed app.",
        },
        {
          heading: "Status",
          body: "Improvements planned.",
        },
      ],
    },
    {
      featured: true,
      eyebrow: "SNIPPET LIBRARY · IN DEVELOPMENT",
      title: ["09 Labs"],
      category: "folio",
      image: "/images/09-labs-snippet.png",
      screenshots: [
        { src: "/images/09-labs-snippet-01.png", alt: "09 Labs component library overview" },
        { src: "/images/09-labs-snippet-02.png", alt: "09 Labs design system detail" },
      ],
      summary:
        "A frontend snippet library with theme and layout controls. A broader reusable component system is a future direction.",
      tags: ["React", "TypeScript"],
      githubUrl: "https://github.com/DeafGecko/09-labs-snippet",
      websiteUrl: "https://09-labs-snippet-zeta.vercel.app",
      caseStudyStatus: "In development",
      caseStudySections: [
        {
          heading: "What I Built",
          body: "09 Labs is a frontend snippet library in development. The screenshots show its browsing interface and theme variations.\n\nThe longer-term goal is to connect this work with reusable components and design tokens. A completed, documented design system is not yet part of this case study.",
        },
        {
          heading: "Design Direction",
          body: "The project achieves a balance between clean minimalism and rich personality through:\n\nMinimal structure: Uncluttered layouts with responsive single-click drawers and intuitive grid/list view modes.\n\nStrong Typography: Optimized text hierarchy paired with code block formatting.\n\nCreative Details: Custom color themes (Light, Coffee, and Dark) with contrast verification still to document.\n\nPurposeful Motion: Smooth slide-over navigation drawers, command palettes (Cmd+K), and interactive modal states.",
        },
        {
          heading: "Why I Built It",
          body: "As front-end requirements evolve, maintaining consistency across multiple applications becomes challenging. 09 Labs bridges design and engineering by standardizing:\n\n- Color and theme design tokens\n\n- Typography scales and responsive padding\n\n- Reusable React components and modular layouts\n\n- Full client-side CRUD capabilities (Create, Read, Update, Delete) via robust localStorage data structures.",
        },
        {
          heading: "What I Plan to Build",
          body: "Buttons → Inputs → Cards → Navigation → Modals → Layouts\n\nEach component will have reusable styles, states, and variants.",
        },
        {
          heading: "What I'm Learning",
          body: "09 Labs helps me practice:\n\nReusable React components\nDesign tokens\nComponent variants\nAccessibility\nResponsive design\nDocumentation\n\nIt also gives me a place to bring my design and development skills together.",
        },
        {
          heading: "Goal",
          body: "My goal is to build a small but useful system that I can actually use in my own projects.\n\nNot hundreds of components.\n\nJust components that are clear, reusable, expressive, and well built.",
        },
        {
          heading: "Status",
          body: "In development — interface and documentation are being refined.",
        },
      ],
    },
    {
      eyebrow: "DESIGN TOKEN & CONTRAST ENGINE",
      title: ["CHROMATIQUE", "STUDIO"],
      category: "chromatique",
      image: "/images/chroma01.png",
      screenshots: [
        { src: "/images/chroma01.png", alt: "Chromatique Studio overview" },
      ],
      summary:
        "A design token and contrast auditing tool — real-time accessibility checks, live component preview, and one-click CSS variable export.",
      tags: ["Vue 3", "Vite", "Tailwind", "VueUse"],
      githubUrl: "https://github.com/DeafGecko/chromatique-studio",
      websiteUrl: "https://chroma.09labs.dev",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What I Built",
          body: "Chromatique Studio is a tool for designers and developers to test colors before using them in a project.\n\nThe main flow is simple:\n\nPick colors → Check contrast → Build tokens → Export CSS",
        },
        {
          heading: "Why I Built It",
          body: "A color can look good but still be hard to read.\n\nI wanted one tool where I could check accessibility while building a color system instead of finding problems later.\n\nIt also connects two things I work with:\n\nDesign + Development",
        },
        {
          heading: "How I Built It",
          body: "I started with the most important part:\nText color + Background color → Contrast score → Pass or Fail\n\nThen I added design tokens, previews, and CSS export.\n\nWhy Vue 3 + VueUse?\n\nMost of my projects use React, so I wanted to challenge myself with another framework.\n\nI built Chromatique Studio with Vue 3 to learn how Vue handles components, state, and reactivity.",
        },
        {
          heading: "Tech I Used",
          body: "Vue handles the interface and color changes. VueUse helps with things like saving data and copying CSS.",
        },
        {
          heading: "Accessibility",
          body: "Accessibility is part of the main purpose of this project.\n\nThe tool checks colors against WCAG AA and AAA contrast levels.\n\nI still plan to improve the tool's own keyboard navigation and focus states.",
        },
        {
          heading: "What I Learned",
          body: "This project helped me understand that accessibility can be part of the design process from the beginning.\n\nIt also gave me real practice using Vue instead of only learning it through tutorials.",
        },
        {
          heading: "Where It Is Now",
          body: "The core tool is built.\n\n✓ Color testing\n✓ Contrast checking\n✓ Design tokens\n✓ Component previews\n✓ CSS export\n\nI am still testing and improving the experience before I consider it finished.",
        },
        {
          heading: "Status",
          body: "Functional and being polished.",
        },
      ],
    },
    {
      eyebrow: "STOREFRONT & CHECKOUT",
      title: ["SWISS E-COMMERCE"],
      category: "swiss",
      image: "/images/ecommerce01.png",
      screenshots: [
        { src: "/images/ecommerce01.png", alt: "Swiss E-Commerce wireframe" },
        {
          src: "/images/ecommerce02.png",
          alt: "Swiss E-Commerce final design",
        },
      ],
      summary:
        "A responsive storefront with product filtering, cart, wishlist, and a mock checkout — built around Swiss design principles.",
      tags: ["React", "Tailwind", "Vercel"],
      githubUrl: "https://github.com/DeafGecko/swiss-ecommerce",
      websiteUrl: "https://ecommerce.09labs.dev",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What I Built",
          body: `Swiss E-Commerce is a responsive online store built with a clean Swiss design style.\n\nThe shopping flow is:\n\nBrowse → Find Product → Add to Cart → Checkout\n\nIt also includes a wishlist and product filtering.`,
        },
        {
          heading: "Why I Built It",
          body: `I wanted to practice building a real e-commerce experience instead of only making a product page.\n\nE-commerce gave me practice with:\n\nLayout + Components + State + Forms + Responsive Design`,
        },
        {
          heading: "How I Built It",
          body: `I built this project in 3 phases.\n\nPhase 1 — Structure\n\nBuild the wireframe, grid, spacing, and layout.\n↓\nPhase 2 — Color\nAdd the colors and visual style.\n↓\nPhase 3 — Motion\n\nAdd animation, hover effects, and interactions.\n\nThis helped me focus on one problem at a time.`,
        },
        {
          heading: "My Challenge",
          body: `My biggest challenge was actually not jumping ahead.\n\nAs a designer, I naturally wanted to start adding colors and animation while I was still building Phase 1.\n\nI had to tell myself:\n\nStructure first → Style second → Motion last\n\nStaying with the wireframe helped me understand how the layout worked before making it look finished.`,
        },
        {
          heading: "What I Learned",
          body: "This project taught me that a strong design starts underneath the final look.\n\nGood structure → Good foundation → Better final design\n\nI also learned that following a clear process can make development easier because I am solving one type of problem at a time.",
        },
        {
          heading: "Where It Is Now",
          body: "The storefront is working and live.\n\nThe project gave me more practice with React state, responsive layouts, shopping flows, and building a UI step by step.",
        },
        {
          heading: "Status",
          body: "Functional and being polished.",
        },
      ],
    },
    {
      eyebrow: "MINIMALIST WRITING APP",
      title: ["KANSO"],
      category: "kanso",
      image: "/images/Kanso01.png",
      screenshots: [
        { src: "/images/Kanso01.png", alt: "Kanso writing interface" },
        { src: "/images/Kanso02.png", alt: "Kanso writing controls" },
      ],
      summary:
        "A distraction-free writing app inspired by Japanese simplicity — theme and font controls, word/paragraph limits, local file save.",
      tags: ["React", "Tailwind"],
      githubUrl: "https://github.com/DeafGecko/kanso-2.0",
      websiteUrl: "https://kanso.09labs.dev",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What I Built",
          body: "Kanso is a simple writing app made to help people focus.\n\nThe idea is:\n\nOpen → Write → Focus → Save\n\nNo busy dashboard. No large toolbar. Just the tools needed for writing.",
        },
        {
          heading: "Why I Built It",
          body: "Many writing apps have a lot of buttons, menus, and features.\n\nSometimes I just want a quiet place to write.\n\nI wanted Kanso to feel simple and calm, based on the Japanese idea of Kanso — simplicity and removing what is not needed.",
        },
        {
          heading: "How I Built It",
          body: "I started with the writing area first.\n\nThen I slowly added tools that help the writing experience:\n\nWriting → Word count → Fonts → Limits → Save\n\nIf a feature did not help someone write, I tried not to add it.",
        },
        {
          heading: "Tech I Used",
          body: "React + Tailwind CSS. I kept the stack focused on the writing interface, its controls, and local file interactions.",
        },
        {
          heading: "Main Features",
          body: "✓ Clean writing space\n\n✓ Word and character count\n✓ Paragraph and page count\n✓ Writing limits\n✓ Font choices\n✓ Save and open files\n✓ New document",
        },
        {
          heading: "Accessibility",
          body: "I included serif and sans-serif font choices so users can choose what is easier for them to read.\n\nI still want to improve keyboard navigation, labels, and other accessibility details.",
        },
        {
          heading: "What I Learned",
          body: "Kanso taught me that good design is not always about adding more.\n\nSometimes the better question is:\n\n“Does the user really need this?”\n\nIt helped me think more carefully about simplicity, focus, and the writing experience.",
        },
        {
          heading: "Where It Is Now",
          body: "My next step is improving the design, interactions, and accessibility.",
        },
        {
          heading: "Status",
          body: "Functional and being polished.",
        },
      ],
    },
  ],
} = Astro.props;
---

<section class="works" id="works-section" aria-labelledby="works-title">
  <div class="works-header">
    <div class="works-heading-block">
      <h2 class="works-title" id="works-title">{heading}</h2>
    </div>
    <p class="works-hint">{hint}</p>
  </div>

  <ul class="works-accordion" id="worksAccordion">
    {
      [...works].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))).map((work, i) => (
        <li
          class="slice"
          class:list={[{ "is-active": true }]}
          data-index={i}
        >
          <div
            class={`slice-bg pattern-${work.category}${work.image ? " has-image" : ""}`}
            style={work.image ? `background-image:url(${work.image})` : ""}
          />
          <div class="slice-overlay" />
          <div class="slice-topline">
            <span class="slice-number">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="slice-vertical-label" aria-hidden="true">
            <span class="slice-vertical-name">
              {work.title.join(" ")} · {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <div class="slice-cue" aria-hidden="true">
            <svg class="slice-cue-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </div>
          <div class="slice-content">
            <p class="slice-eyebrow">{work.featured ? "FEATURED · " : ""}{work.eyebrow}</p>
            <h3 class="slice-title">
              {work.title.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </h3>
            {work.summary && <p class="slice-summary">{work.summary}</p>}
            {work.tags && work.tags.length > 0 && (
              <div class="slice-tags">
                {work.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <div class="slice-links">
              <button
                type="button"
                class="project-link project-case-study"
                data-case-study-trigger
                data-title={work.title.join(" ")}
                data-eyebrow={work.eyebrow}
                data-summary={
                  work.summary ?? "Project details are being prepared."
                }
                data-tags={JSON.stringify(work.tags ?? [])}
                data-github-url={work.githubUrl ?? ""}
                data-github-note={work.githubNote ?? ""}
                data-website-url={work.websiteUrl ?? ""}
                data-website-url2={work.websiteUrl2 ?? ""}
                data-website-url2-label={work.websiteUrl2Label ?? ""}
                data-case-study-sections={JSON.stringify(
                  work.caseStudySections ?? [],
                )}
                data-case-study-status={work.caseStudyStatus ?? ""}
                data-screenshots={JSON.stringify(
                  work.screenshots ??
                    (work.image
                      ? [
                          {
                            src: work.image,
                            alt: `${work.title.join(" ")} project screenshot`,
                          },
                        ]
                      : []),
                )}
                aria-label={`Open ${work.title.join(" ")} case study`}
              >
                <FileSearch
                  className="case-study-trigger-icon"
                  size={15}
                  strokeWidth={1.8}
                  aria-hidden="true"
                />
                Case Study
              </button>
              {work.githubUrl && (
                <a
                  class="project-link"
                  href={work.githubUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`View ${work.title.join(" ")} on GitHub`}
                  title="View GitHub repository"
                >
                  <img
                    class="project-link-icon"
                    src="/github.svg"
                    alt=""
                    aria-hidden="true"
                  />
                </a>
              )}
              {work.websiteUrl && (
                <a
                  class="project-link"
                  href={work.websiteUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Visit ${work.title.join(" ")} website`}
                  title="Open live demo"
                >
                  <img
                    class="project-link-icon"
                    src="/website-icon.svg"
                    alt=""
                    aria-hidden="true"
                  />
                </a>
              )}
              {work.websiteUrl2 && (
                <a
                  class="project-link"
                  href={work.websiteUrl2}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={
                    work.websiteUrl2Label ??
                    `Visit ${work.title.join(" ")} (alt)`
                  }
                  title={work.websiteUrl2Label ?? "Open alternate link"}
                >
                  <svg
                    class="project-link-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="7.5" cy="15.5" r="5.5" />
                    <path d="M21 2l-9.6 9.6" />
                    <path d="M15.5 7.5l3 3L22 7l-3-3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <dialog
    class="case-study-modal"
    id="caseStudyModal"
    aria-labelledby="caseStudyTitle"
  >
    <div class="case-study-panel">
      <button
        class="case-study-close"
        type="button"
        data-case-study-close
        aria-label="Close case study">×</button
      >
      <p class="case-study-kicker" id="caseStudyEyebrow"></p>
      <h3 class="case-study-title" id="caseStudyTitle"></h3>
      <p class="case-study-summary" id="caseStudySummary"></p>
      <div
