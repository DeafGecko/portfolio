---
import { FileSearch } from "lucide-react";

export interface CaseStudySection {
  heading: string;
  body: string;
}

export interface WorkItem {
  eyebrow: string;
  title: string[];
  category: string;
  featured?: boolean;
  summary?: string;
  tags?: string[];
  /** reserved for future case study page — not yet implemented */
  caseStudyUrl?: string;
  githubUrl?: string;
  /** shown as text in the modal instead of an icon link (e.g. "Private — available on request") */
  githubNote?: string;
  websiteUrl?: string;
  websiteUrl2?: string;
  websiteUrl2Label?: string;
  labUrl?: string;
  /** optional real screenshot — falls back to a generated pattern */
  image?: string;
  /** rich case study sections rendered inside the modal */
  caseStudySections?: CaseStudySection[];
  /** status badge shown at the bottom of the case study (e.g. "In development") */
  caseStudyStatus?: string;
  /** up to 2 screenshots shown in the modal gallery */
  screenshots?: { src: string; alt: string }[];
}

export interface Props {
  heading?: string;
  hint?: string;
  works?: WorkItem[];
}

const {
  heading = "SELECTED WORKS",
  hint = "Explore working projects, design decisions, and what is still in development.",
  works = [
    {
      featured: true,
      eyebrow: "VENUE OPERATIONS PLATFORM",
      title: ["THE MILLS AT SUGARCREEK"],
      category: "factory",
      image: "/images/factory-dashboard-laptop.png",
      screenshots: [
        { src: "/images/factory-dashboard-laptop.png", alt: "The Mills at Sugarcreek dashboard shown on a laptop" },
      ],
      summary:
        "A demo booking and admin app for an event venue, built for my own practice. It covers bookings, payments and role-based access.",
      tags: ["Astro", "React", "TypeScript", "Tailwind CSS", "Cloudflare Workers", "D1", "Sanity"],
      githubUrl: "https://github.com/DeafGecko/venue-operations",
      websiteUrl: "https://venue-operations-api.dwirog.workers.dev/admin/dashboard",
      caseStudyStatus: "Demo",
      caseStudySections: [
        {
          heading: "Who uses it",
          body: "This is a demo app for an event venue. I built it for myself to practice and test ideas. It is not used by a real venue.\n\nIt has four staff roles: admin, manager, developer and viewer.",
        },
        {
          heading: "Why I built it",
          body: "Some venue software is too hard to use. I wanted something simpler, with one place to see events, make bookings, check the calendar and find clients.\n\nI also wanted a real project to learn Astro and practice full-stack work.",
        },
        {
          heading: "What I built",
          body: "A two-step booking form that checks the details before it saves.\n\nA dashboard with money by month, money by event type and upcoming events.\n\nA calendar that shows paid, partly paid or unpaid events.\n\nRoles that limit what each person can change. The server enforces this, not only the screen.\n\nA read-only public view. Other pages need an access code.",
        },
        {
          heading: "Choices I made",
          body: "Astro, because most pages only show data. React, only where a page needs interaction.\n\nCloudflare Workers runs the app, D1 is the database, and Sanity stores the venue data.\n\nThe server builds each booking, so the form cannot change the price.",
        },
        {
          heading: "What I fixed after testing",
          body: "A fake cookie got into the admin area. I fixed it by signing sessions with HMAC.\n\nSign-in failed on Cloudflare because secrets were not readable at runtime. I turned on runtime access.\n\nI learned that working locally does not mean it will work in production.",
        },
        {
          heading: "Testing",
          body: "I ran 19 unit tests with Vitest, and none failed.\n\nI ran Playwright browser tests at desktop and phone sizes. The last full run had two failures. I fixed both and ran it again.",
        },
        {
          heading: "Still to do",
          body: "Color contrast still fails on many pages. Invite and reset emails need an email key. I deploy by hand with Wrangler.",
        },
      ],
    },
    {
      eyebrow: "EVENT PHOTO SHARING",
      title: ["VANTGE"],
      category: "vantge",
      image: "/images/vantge-mockup.png",
      screenshots: [
        { src: "/images/vantge-mockup.png", alt: "Vantge event dashboard and phone guest page" },
      ],
      featured: true,
      summary:
        "A web app for hosting an event. A host shares a photo gallery and an invitation through one link or QR code, and runs everything from one dashboard.",
      tags: ["Product Design", "Host & Guest Workflows", "Browser demo"],
      websiteUrl: "https://vantge.app/try",
      labUrl: "https://lab.09folio.com",
      githubUrl: "https://github.com/DeafGecko/vantge",
      caseStudyStatus: "Live demo",
      caseStudySections: [
        {
          heading: "Summary",
          body: "Try the demo at vantge.app/try. The access code is Demo.\n\nVantge is a web app for hosting an event. A host shares a photo gallery and an invitation through one link or QR code, and runs everything from one dashboard.\n\nI designed and built the host dashboard, the guest pages, and a browser-only demo.",
        },
        {
          heading: "The problem",
          body: "Hosts use several tools for one event, and guests have to remember several links. I wanted one event with one link.",
        },
        {
          heading: "What I built",
          body: "A live preview that updates as the host types or picks a color, font or background.\n\nA background photo for each screen size: portrait for phones, landscape for desktop.\n\nGuest pages that match the preview, with photo upload and a gallery.\n\nThe demo at /try uses sample data. Edits stay in the browser, and nothing reaches the live database.",
        },
        {
          heading: "Key decisions",
          body: "The demo uses an in-browser stand-in for the database, so it is safe to share and easy to reset.\n\nThe preview stays beside the settings while you scroll.\n\nEach page loads only when it is opened. The home page bundle went from about 930KB to about 225KB.",
        },
        {
          heading: "Testing",
          body: "I ran 6 unit tests with Vitest, and none failed.\n\nI ran Playwright with axe on the home and login pages. The scans found 15 low-contrast text problems, which I fixed.\n\nI checked 5 pages at 360, 390 and 430 pixels. None scrolled sideways.",
        },
        {
          heading: "Results",
          body: "A visitor can go from the start page to a styled event dashboard in three steps.\n\nOn the live build, the home page scores 100 on accessibility, best practices and SEO. I have not measured real visitor numbers yet.",
        },
        {
          heading: "Next steps",
          body: "The access code is Demo, at vantge.app/try.\n\nI want to cut the JavaScript still loaded on the demo page, and measure how long a new host takes to create an event with real users.",
        },
      ],
    },
    {
      featured: true,
      eyebrow: "VISUAL COMMUNICATION APP",
      title: ["SHOWCARD"],
      category: "clearcard",
      image: "/images/showcard-mockup.png",
      screenshots: [
        {
          src: "/images/showcard-mockup.png",
          alt: "ShowCard app on a phone and laptop",
        },
      ],
      summary:
        "A card app for Deaf and hard-of-hearing people. Save the messages you use most and show them in large text with one tap.",
      tags: ["React", "TypeScript", "Vite", "Accessibility"],
      githubUrl: "https://github.com/DeafGecko/clearcard",
      websiteUrl: "https://showcard.09labs.dev",
      labUrl: "https://lab.09folio.com",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What it is",
          body: "ShowCard is a card app for Deaf and hard-of-hearing people. You save the messages you use most, like a doctor visit or a coffee order. When you need to say something, you tap a card and the message shows in large text for the other person to read.\n\nI designed it, built it and tested it on my own.",
        },
        {
          heading: "The problem",
          body: "Typing the same message over and over is slow, and harder during a medical visit or an emergency. Sometimes you just need to show a message fast, without speaking.",
        },
        {
          heading: "What I did",
          body: "I created the whole product, including the product and interaction design, the responsive interface, accessibility improvements, private-card security and encryption, automated unit and browser tests, and the documentation.",
        },
        {
          heading: "What it does",
          body: "You make your own cards and show any card full screen. You can sort cards into groups, and emergency cards are easy to reach. There is a quick-write option for a one-time message.\n\nPrivate cards are locked with a six-digit code, with a one-time backup key if you forget it. You can change the text size and pick light, dark or high-contrast colors.",
        },
        {
          heading: "Privacy",
          body: "Private cards are encrypted before they are saved. I don't store the six-digit code. I store a derived hash, and a random key protects the data. After too many wrong codes, the app locks for a short time.\n\nA six-digit code is short, so if someone gets a copy of the browser data, they could try to guess it. I want to be clear about that limit.",
        },
        {
          heading: "How I tested it",
          body: "I tested it as a responsive web app. Playwright checked the features, the error messages, phone-sized layouts, keyboard use and accessibility. Vitest covered the unit tests.\n\nI have not tested it with Expo or Xcode. It is a web app, not a native iPhone app, so I have not tried it on a real iPhone yet.",
        },
        {
          heading: "What was hard",
          body: "Keeping private data safe without making sign-in confusing. I kept the code separate from the encryption key, so changing the code doesn't mean re-encrypting every private card.\n\nThe automatic accessibility tests found real problems, but I still need to test with real users and real phones.",
        },
        {
          heading: "What's next",
          body: "Test with Deaf and hard-of-hearing people, and with screen readers on a real iPhone and Android phone. Make it installable and work offline. Decide whether to build a native app with Expo or wrap this one with Capacitor.",
        },
      ],
    },
    {
      eyebrow: "DESIGN TOKEN & CONTRAST ENGINE",
      title: ["CHROMATIQUE"],
      category: "chromatique",
      image: "/images/chromatique-mockup.png",
      screenshots: [
        { src: "/images/chromatique-mockup.png", alt: "Chromatique Studio color tool on a monitor" },
      ],
      summary:
        "A tool for testing a text color and a background color before you use them in code. It shows WCAG and APCA contrast side by side, with a live preview and exports to CSS, Tailwind and design tokens.",
      tags: ["Vue 3", "Vite", "Tailwind CSS", "VueUse"],
      githubUrl: "https://github.com/DeafGecko/chromatique-studio",
      websiteUrl: "https://chroma.09labs.dev",
      labUrl: "https://lab.09folio.com",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "The problem",
          body: "Picking a text color and a background color is easy to get wrong. A pair can look fine on my screen and still be hard to read for someone else.\n\nWCAG and APCA also disagree. WCAG can pass some pale pairs that read badly. APCA tracks how people see lightness, but most tools don't show it next to WCAG.",
        },
        {
          heading: "What I built",
          body: "Chromatique Studio is a tool for testing two colors before they go into code. You enter a surface color and a text color, and it shows both checks side by side.\n\nThe preview uses the same two colors, and you can edit the text to try your own copy. There are color-blindness previews, a shade scale, saved pairs and exports to CSS, Tailwind and design tokens. The current pair goes in the URL, so a link opens the same colors.",
        },
        {
          heading: "Why I show both checks",
          body: "I didn't want to pick a winner. The useful part is where the two checks agree and where they split. If a pair passes one and fails the other, you should stop and look.",
        },
        {
          heading: "How I built it",
          body: "It's Vue 3 with the Composition API. The color state and the contrast math live in one composable, so I could test the math without opening the UI.\n\nI also laid the tool out on one card, so a laptop and an iPad fit the screen with no scrolling.",
        },
        {
          heading: "Testing",
          body: "I ran 30 unit tests with Vitest, and none failed. I ran 16 browser tests with Playwright, including axe scans on every preset and color-blindness mode, and none failed.\n\nLighthouse on the live build scores 100 for performance, accessibility, best practices and SEO.",
        },
        {
          heading: "What went wrong",
          body: "Playwright was quietly testing another project, because both used the same port. Moving it to its own port fixed that.\n\nMy APCA score for black on white was 114, but the reference is 106. The unit test caught it.\n\nA hint at 95 percent opacity dropped the red below AA contrast. Removing the opacity fixed it.\n\nThe scans ran during a color fade and read blended colors. They now wait for the final color.",
        },
        {
          heading: "Next",
          body: "I want an accent color with suggestions that already pass contrast, component tests for the Vue parts, and a manual screen-reader pass. Automated checks miss reading order and meaning.",
        },
      ],
    },
    {
      eyebrow: "STOREFRONT & CHECKOUT",
      title: ["MONOLITH"],
      category: "swiss",
      image: "/images/monolith-mockup.png",
      screenshots: [
        { src: "/images/monolith-mockup.png", alt: "Monolith storefront on a desktop monitor" },
      ],
      summary:
        "A small online store built in a three-step process: layout, accent colors, and animation.",
      tags: ["Next.js", "React", "Prisma", "Zustand", "Tailwind CSS"],
      githubUrl: "https://github.com/DeafGecko/swiss-ecommerce/tree/main/swiss-ecommerce",
      websiteUrl: "https://ecommerce.09labs.dev",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "How I built it, in three steps",
          body: "I built Monolith in three steps: the layout first, then the accent colors, then the animation.\n\nFirst I built the layout in grayscale. I wanted the grid, the spacing and the section order to work before anything looked finished.\n\nThen I added the accent color on top of that base. I did not use color to fix a layout that wasn't working yet.\n\nLast, I added the animation, so it would not hide problems in the layout or the colors.\n\nThe hardest part was not jumping ahead. As a designer, I wanted to add color and motion early. The three looks in the header come from these steps: grayscale, color and animated.",
        },
      ],
    },
    {
      eyebrow: "MINIMALIST WRITING APP",
      title: ["KANSO"],
      category: "kanso",
      image: "/images/kanso-mockup.png",
      screenshots: [
        { src: "/images/kanso-mockup.png", alt: "Kanso writing app on a laptop in a library" },
      ],
      summary:
        "A writing app with no dashboard and no big toolbar. Just a page and the few tools you need to write.",
      tags: ["React", "TypeScript", "Vite", "Tailwind CSS"],
      githubUrl: "https://github.com/DeafGecko/kanso-2.0",
      websiteUrl: "https://kanso.09labs.dev",
      labUrl: "https://lab.09folio.com",
      caseStudyStatus: "Live",
      caseStudySections: [
        {
          heading: "What it is",
          body: "Kanso is a writing app for focus. There is no dashboard and no big toolbar, just a page and the few tools you need to write. It is React and TypeScript, with no backend, so your work stays in the browser.",
        },
        {
          heading: "The problem I fixed first",
          body: "The sidebar had two close controls. The header button opened it, but once it was open, the close button moved inside the panel, so it was hard to find. I wanted one button in the header that works in both states.",
        },
        {
          heading: "What I changed",
          body: "The header button now opens and closes the sidebar, and its label and icon change with the state. I removed the second close button.\n\nI added a pen logo beside the KANSO name. I also replaced the favicon with the same pen.\n\nThe accessibility scan flagged the small sidebar labels, so I raised their opacity from 40 or 50 percent to 70 percent. It took three rounds, because the first change missed some label styles.",
        },
        {
          heading: "Tests",
          body: "I used Vitest for unit tests on the header button, and Playwright for browser tests on desktop and phone sizes. Each browser run also runs an axe scan, with the sidebar open and closed. The tests work whether the saved setting opens or closes the sidebar.",
        },
        {
          heading: "The build that was failing",
          body: "The production build was failing before I started. A Vite setting was written in a form this version rejects, and Vercel would have failed the same way. I changed it, and the build passes.",
        },
        {
          heading: "Results",
          body: "Vitest passes 2 of 2 tests and Playwright passes 6 of 6, including the axe scans. Lint is clean, and the live site scores 100 in all four Lighthouse categories. The dev server scores lower, because it doesn't bundle the code.",
        },
        {
          heading: "What I learned",
          body: "Run the same build command the host runs before merging. Measure the live site, not the dev server. When you change a color, search for the color itself, not one class name. And check small icons at their real size, since the pen's details disappeared at 32 pixels.",
        },
      ],
    },
  ],
} = Astro.props;
---

<section class="works" id="works-section" aria-labelledby="works-title">
  <div class="works-header">
    <div class="works-heading-block">
      <h2 class="works-title" id="works-title">{heading}</h2>
    </div>
    <p class="works-hint">{hint}</p>
  </div>

  <ul class="works-accordion" id="worksAccordion">
    {
      [...works].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))).map((work, i) => (
        <li
          class="slice"
          class:list={[{ "is-active": true }]}
          data-index={i}
        >
          <div
            class={`slice-bg pattern-${work.category}${work.image ? " has-image" : ""}`}
            style={work.image ? `background-image:url(${work.image})` : ""}
          />
          {work.websiteUrl && (
            <a
              class="slice-image-link"
              href={work.websiteUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={`View ${work.title.join(" ")} live`}
              title="View live"
            />
          )}
          <div class="slice-overlay" />
          <div class="slice-topline">
            <span class="slice-number">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="slice-vertical-label" aria-hidden="true">
            <span class="slice-vertical-name">
              {work.title.join(" ")} · {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <div class="slice-content">
            <p class="slice-eyebrow">{work.featured ? "FEATURED · " : ""}{work.eyebrow}</p>
            <h3 class="slice-title">
              {work.title.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </h3>
            {work.summary && <p class="slice-summary">{work.summary}</p>}
            {work.tags && work.tags.length > 0 && (
              <div class="slice-tags">
                {work.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <div class="slice-links">
              <button
                type="button"
                class="project-link project-case-study"
                data-case-study-trigger
                data-title={work.title.join(" ")}
                data-eyebrow={work.eyebrow}
                data-summary={
                  work.summary ?? "Project details are being prepared."
                }
                data-tags={JSON.stringify(work.tags ?? [])}
                data-github-url={work.githubUrl ?? ""}
                data-github-note={work.githubNote ?? ""}
                data-website-url={work.websiteUrl ?? ""}
                data-website-url2={work.websiteUrl2 ?? ""}
                data-website-url2-label={work.websiteUrl2Label ?? ""}
                data-case-study-sections={JSON.stringify(
                  work.caseStudySections ?? [],
                )}
                data-case-study-status={work.caseStudyStatus ?? ""}
                data-screenshots={JSON.stringify(
                  work.screenshots ??
                    (work.image
                      ? [
                          {
                            src: work.image,
                            alt: `${work.title.join(" ")} project screenshot`,
                          },
                        ]
                      : []),
                )}
                aria-label={`Open ${work.title.join(" ")} case study`}
              >
                <FileSearch
                  className="case-study-trigger-icon"
                  size={15}
                  strokeWidth={1.8}
                  aria-hidden="true"
                />
                Case Study
              </button>
              {work.githubUrl && (
                <a
                  class="project-link"
                  href={work.githubUrl}
                  data-tip="GitHub"
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`View ${work.title.join(" ")} on GitHub`}
                  title="View GitHub repository"
                >
                  <img
                    class="project-link-icon"
                    src="/github.svg"
                    alt=""
                    aria-hidden="true"
                  />
                </a>
              )}
              {work.websiteUrl && (
                <a
                  class="project-link"
                  href={work.websiteUrl}
                  data-tip="View live"
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Visit ${work.title.join(" ")} website`}
                  title="Open live demo"
                >
                  <img
                    class="project-link-icon"
                    src="/website-icon.svg"
                    alt=""
                    aria-hidden="true"
                  />
                </a>
              )}
              {work.labUrl && (
                <a
                  class="project-link project-link-lab"
                  href={work.labUrl}
                  data-tip="App Quality Lab"
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Open ${work.title.join(" ")} in App Quality Lab`}
                  title="Open App Quality Lab"
                >
                  <img
                    class="project-link-lab-icon"
                    src="/brand/lab-icon.png"
                    alt=""
                    aria-hidden="true"
                    width="28"
                    height="28"
                  />
                </a>
              )}
              {work.websiteUrl2 && (
                <a
                  class="project-link"
                  href={work.websiteUrl2}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={
                    work.websiteUrl2Label ??
                    `Visit ${work.title.join(" ")} (alt)`
                  }
                  title={work.websiteUrl2Label ?? "Open alternate link"}
                >
                  <svg
                    class="project-link-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="7.5" cy="15.5" r="5.5" />
                    <path d="M21 2l-9.6 9.6" />
                    <path d="M15.5 7.5l3 3L22 7l-3-3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <dialog
    class="case-study-modal"
    id="caseStudyModal"
    aria-labelledby="caseStudyTitle"
  >
    <div class="case-study-panel">
      <button
        class="case-study-close"
        type="button"
        data-case-study-close
        aria-label="Close case study">×</button
      >
      <p class="case-study-kicker" id="caseStudyEyebrow"></p>
      <h3 class="case-study-title" id="caseStudyTitle"></h3>
      <p class="case-study-summary" id="caseStudySummary"></p>
      <div
        class="case-study-tags"
        id="caseStudyTags"
        aria-label="Technologies used"
      >
      </div>
      <!-- screenshot gallery (populated by JS when screenshots present) -->
      <div class="case-study-gallery" id="caseStudyGallery" hidden></div>
      <!-- rich case study sections (populated by JS when caseStudySections present) -->
      <div class="case-study-body" id="caseStudyBody" hidden></div>
      <div class="case-study-actions">
        <a
          class="case-study-action"
          id="caseStudyGithub"
          target="_blank"
          rel="noreferrer"
          aria-label="View on GitHub"
          title="View on GitHub"
        >
          <img
            class="case-study-action-icon"
            src="/github.svg"
            alt=""
            aria-hidden="true"
          />
        </a>
        <!-- shown instead of icon when repo is private -->
        <span class="case-study-github-note" id="caseStudyGithubNote" hidden
        ></span>
        <a
          class="case-study-action"
          id="caseStudyWebsite"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit website"
          title="Visit website"
        >
          <img
            class="case-study-action-icon"
            src="/website-icon.svg"
            alt=""
            aria-hidden="true"
          />
        </a>
        <a
          class="case-study-action"
          id="caseStudyWebsite2"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit alternate site"
          title="Visit alternate site"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="7.5" cy="15.5" r="5.5"></circle>
            <path d="M21 2l-9.6 9.6"></path>
            <path d="M15.5 7.5l3 3L22 7l-3-3"></path>
          </svg>
        </a>
        <span class="case-study-status" id="caseStudyStatus" hidden></span>
      </div>
    </div>
  </dialog>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .works {
    width: 100%;
    padding: calc(1.75rem + 10px) 6% 7rem;
    background: #dfe2e3;
    transition: background 0.3s ease;
  }

  :global(.dark) .works {
    background: #0a0e17;
  }

  .works-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .works-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #2a52cc;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  :global(.dark) .works-kicker {
    color: #6a9eff;
  }

  .works-kicker .dot {
    width: 7px;
    height: 7px;
    background: #2a52cc;
    display: inline-block;
    flex-shrink: 0;
  }

  :global(.dark) .works-kicker .dot {
    background: #6a9eff;
  }

  .works-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #454c56;
    margin: 0;
  }

  :global(.dark) .works-title {
    color: #eef4ff;
  }

  .works-hint {
    font-family: "Azeret Mono", monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #17377e;
    font-weight: 500;
    letter-spacing: 0.5px;
    max-width: 280px;
    text-align: right;
    margin: 0 0 0.35rem;
  }

  :global(.dark) .works-hint {
    color: #9bc1ff;
  }

  .works-accordion {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    width: 100%;
    height: min(60vh, 620px);
    min-height: 380px;
    border: 1px solid rgba(42, 82, 204, 0.15);
    border-radius: 4px;
    padding: 0.6rem;
    gap: 0.6rem;
    background: rgba(42, 82, 204, 0.02);
    overflow: hidden;
  }

  :global(.dark) .works-accordion {
    border-color: rgba(80, 150, 255, 0.15);
    background: rgba(10, 14, 23, 0.4);
  }

  @property --work-border-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes work-border-travel {
    to {
      --work-border-angle: 360deg;
    }
  }

  .slice {
    position: relative;
    flex: 1 1 0%;
    min-width: 64px;
    height: 100%;
    border: 0;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    cursor: pointer;
    overflow: hidden;
    background: #384351;
    text-align: left;
    font: inherit;
    color: inherit;
    transition:
      flex-grow 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  :global(.dark) .slice {
    background: #12161f;
  }

  .slice::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--work-border-angle),
      rgba(42, 82, 204, 0.2),
      #5a8eff,
      rgba(42, 82, 204, 0.2) 35%,
      rgba(42, 82, 204, 0.2) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }

  .slice:hover,
  .slice:has(.slice-activator:focus-visible) {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .slice:hover::before,
  .slice:has(.slice-activator:focus-visible)::before {
    opacity: 1;
    animation: work-border-travel 2.4s linear infinite;
  }

  .slice:has(.slice-activator:focus-visible) {
    outline: 3px solid #5a8eff;
    outline-offset: 2px;
    z-index: 3;
  }

  .slice-activator {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .slice-activator:focus-visible {
    outline: none;
  }

  .slice.is-active {
    flex-grow: 8;
  }

  .slice-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.15) brightness(0.55);
    transform: scale(1.04);
    transition:
      filter 0.6s ease,
      transform 0.6s ease;
  }

  .slice.is-active .slice-bg {
    filter: grayscale(1) contrast(1.1) brightness(0.75);
    transform: scale(1);
  }

  html:not(.dark) .slice-bg {
    filter: grayscale(1) contrast(0.94) brightness(1.02);
  }

  html:not(.dark) .slice.is-active .slice-bg {
    filter: grayscale(1) contrast(0.96) brightness(1.04);
  }

  /* real photos need more light than flat CSS patterns */
  .slice-bg.has-image {
    filter: grayscale(1) contrast(1.05) brightness(0.72);
  }
  .slice.is-active .slice-bg.has-image {
    filter: grayscale(1) contrast(1) brightness(0.88);
  }
  html:not(.dark) .slice-bg.has-image {
    filter: grayscale(1) contrast(0.9) brightness(1.08);
  }
  html:not(.dark) .slice.is-active .slice-bg.has-image {
    filter: grayscale(1) contrast(0.92) brightness(1.12);
  }

  /* generated circuit-like placeholder patterns — swap via the `image` prop */
  .pattern-signalcard {
    background-color: #23262f;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(120, 150, 200, 0.35) 0,
        transparent 45%
      ),
      radial-gradient(
        circle at 75% 65%,
        rgba(90, 130, 190, 0.3) 0,
        transparent 40%
      ),
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 26px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 26px
      );
  }
  .pattern-voltfund {
    background-color: #1d222c;
    background-image:
      radial-gradient(
        circle at 65% 20%,
        rgba(130, 160, 210, 0.3) 0,
        transparent 50%
      ),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.035) 0 2px,
        transparent 2px 22px
      );
  }
  .pattern-kanso {
    background-color: #191d25;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 0 1px,
      transparent 1px 34px
    );
  }
  .pattern-factory {
    background-color: #21242d;
    background-image:
      radial-gradient(
        circle at 30% 70%,
        rgba(140, 165, 205, 0.28) 0,
        transparent 45%
      ),
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 20px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 20px
      );
  }
  .pattern-storyone {
    background-color: #1c2029;
    background-image: radial-gradient(
      circle at 50% 40%,
      rgba(150, 175, 215, 0.3) 0,
      transparent 55%
    );
  }
  .pattern-sift {
    background-color: #20232c;
    background-image:
      linear-gradient(180deg, rgba(150, 175, 215, 0.18) 0, transparent 60%),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 0 1px,
        transparent 1px 30px
      );
  }
  .pattern-chromatique {
    background-color: #1e1f2e;
    background-image:
      radial-gradient(
        circle at 40% 30%,
        rgba(160, 120, 220, 0.3) 0,
        transparent 45%
      ),
      radial-gradient(
        circle at 75% 70%,
        rgba(90, 160, 220, 0.25) 0,
        transparent 40%
      ),
      repeating-linear-gradient(
        60deg,
        rgba(255, 255, 255, 0.03) 0 1px,
        transparent 1px 24px
      );
  }
  .pattern-swiss {
    background-color: #1d2028;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 18px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 18px
      );
  }
  .pattern-folio {
    background-color: #1a1d26;
    background-image:
      radial-gradient(
        circle at 60% 40%,
        rgba(120, 160, 210, 0.32) 0,
        transparent 50%
      ),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.04) 0 2px,
        transparent 2px 20px
      );
  }

  /* extra tint for bright screenshots where text gets hard to read */
  .pattern-factory ~ .slice-overlay,
  .pattern-chromatique ~ .slice-overlay,
  .pattern-swiss ~ .slice-overlay,
  .pattern-clearcard ~ .slice-overlay {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.68) 50%,
      rgba(0, 0, 0, 0.96) 100%
    );
  }

  .slice-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 14, 23, 0.15) 0%,
      rgba(10, 14, 23, 0.35) 55%,
      rgba(10, 14, 23, 0.92) 100%
    );
  }

  html:not(.dark) .slice-overlay {
    background: linear-gradient(
      180deg,
      rgba(184, 191, 196, 0.08) 0%,
      rgba(174, 182, 188, 0.34) 55%,
      rgba(163, 172, 179, 0.94) 100%
    );
  }

  html:not(.dark) .pattern-signalcard,
  html:not(.dark) .pattern-kanso,
  html:not(.dark) .pattern-storyone {
    background-color: #b4bbc0;
  }

  html:not(.dark) .pattern-clearcard,
  html:not(.dark) .pattern-factory,
  html:not(.dark) .pattern-sift {
    background-color: #aeb6bc;
  }

  .slice-topline {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .slice.is-active .slice-topline {
    opacity: 1;
    pointer-events: auto;
  }

  .slice-number {
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #6a9eff;
    background: rgba(10, 14, 23, 0.6);
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    padding: 0.3rem 0.55rem;
    white-space: nowrap;
  }

  html:not(.dark) .slice-number {
    color: #274fae;
    background: rgba(223, 226, 227, 0.82);
    border-color: rgba(42, 82, 204, 0.35);
  }

  .slice-badge {
    font-family: "Azeret Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.4px;
    color: #d6e6ff;
    background: rgba(10, 14, 23, 0.7);
    border: 1px solid rgba(106, 158, 255, 0.25);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .slice.is-active .slice-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .slice-content {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 2;
    white-space: normal;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }

  .slice.is-active .slice-content {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s ease 0.15s,
      visibility 0s linear 0.15s;
  }

  .slice-links {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(214, 230, 255, 0.15);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.35s ease 0.1s,
      transform 0.35s ease 0.1s;
  }

  .slice.is-active .slice-links {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .project-link {
    position: relative;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: #d6e6ff;
    background: rgba(10, 14, 23, 0.72);
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .project-case-study {
    width: auto;
    gap: 0.65rem;
    padding: 0 0.8rem;
    cursor: pointer;
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  :global(.case-study-trigger-icon) {
    flex: 0 0 auto;
  }

  .case-study-modal {
    width: min(42rem, calc(100% - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    color: #343b45;
    background: #dfe2e3;
    border: 2px solid #2a52cc;
    border-radius: 4px;
    box-shadow: 0 24px 70px rgba(26, 42, 74, 0.22);
  }

  .case-study-modal::backdrop {
    background: rgba(26, 31, 40, 0.65);
    backdrop-filter: blur(5px);
  }

  :global(.dark) .case-study-modal {
    color: #d6e6ff;
    background: #12161f;
    border-color: #5a8eff;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

  .case-study-panel {
    position: relative;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .case-study-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    color: #343b45;
    background: transparent;
    border: 1px solid #929ba2;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  :global(.dark) .case-study-close {
    color: #eef4ff;
    border-color: rgba(106, 158, 255, 0.4);
  }

  .case-study-close:hover {
    border-color: #2a52cc;
  }

  .case-study-kicker {
    margin: 0 3.5rem 0.75rem 0;
    color: #20469f;
    font:
      600 0.78rem/1.5 "Azeret Mono",
      monospace;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  :global(.dark) .case-study-kicker {
    color: #6a9eff;
  }

  .case-study-title {
    font-family: "Space Grotesk", sans-serif;
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 7vw, 3.5rem);
    line-height: 1;
  }

  .case-study-summary {
    max-width: 58ch;
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.75;
  }

  .case-study-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  :global(.case-study-tag) {
    padding: 0.25rem 0.5rem;
    color: #4a6199;
    border: 1px solid rgba(42, 82, 204, 0.28);
    border-radius: 4px;
    font:
      500 0.62rem/1.2 "Azeret Mono",
      monospace;
    letter-spacing: 0.25px;
  }

  :global(.dark) :global(.case-study-tag) {
    color: #6880a8;
    border-color: rgba(106, 158, 255, 0.2);
  }

  .case-study-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case-study-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #173f9f;
    border: 1px solid #2a52cc;
    border-radius: 4px;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.dark) .case-study-action {
    color: #d6e6ff;
    border-color: #5a8eff;
  }

  .case-study-action-icon {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(23%) sepia(50%) saturate(800%)
      hue-rotate(200deg);
  }

  :global(.dark) .case-study-action-icon {
    filter: brightness(0) invert(1);
  }

  .case-study-action:hover {
    color: #2a52cc;
    border-color: #2a52cc;
    border-width: 2px;
  }

  /* rich case study body */
  .case-study-body {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.cs-section) {
    padding: 1.25rem 0;
    border-top: 1px solid rgba(42, 82, 204, 0.15);
  }

  :global(.cs-section:last-child) {
    border-bottom: 1px solid rgba(42, 82, 204, 0.15);
  }

  :global(.dark) :global(.cs-section) {
    border-top-color: rgba(106, 158, 255, 0.15);
  }

  :global(.dark) :global(.cs-section:last-child) {
    border-bottom-color: rgba(106, 158, 255, 0.15);
  }

  :global(.cs-section-heading) {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #1e2530;
    margin: 0 0 0.4rem;
  }

  :global(.dark) :global(.cs-section-heading) {
    color: #f0f4ff;
  }

  :global(.cs-section-body) {
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.75;
    color: #5a6472;
    margin: 0;
  }

  :global(.cs-section-body + .cs-section-body) {
    margin-top: 0.9rem;
  }

  :global(.dark) :global(.cs-section-body) {
    color: #7e95b2;
  }

  /* screenshot gallery */
  .case-study-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 34rem) {
    .case-study-gallery {
      grid-template-columns: 1fr;
    }
  }

  :global(.cs-screenshot) {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid rgba(42, 82, 204, 0.18);
    display: block;
    transition: border-color 0.2s ease;
  }

  :global(.cs-screenshot:focus-visible) {
    outline: 3px solid #2a52cc;
    outline-offset: -3px;
  }

  :global(.dark) :global(.cs-screenshot) {
    border-color: rgba(106, 158, 255, 0.2);
  }

  /* github private note */
  .case-study-github-note {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 0.85rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: #20469f;
    border: 1px solid rgba(42, 82, 204, 0.4);
    border-radius: 4px;
    white-space: nowrap;
  }

  :global(.dark) .case-study-github-note {
    color: #8aacdf;
    border-color: rgba(106, 158, 255, 0.35);
  }

  /* status badge */
  .case-study-status {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 0.85rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: #20469f;
    background: rgba(42, 82, 204, 0.07);
    border: 1px solid rgba(42, 82, 204, 0.3);
    border-radius: 4px;
    white-space: nowrap;
  }

  :global(.dark) .case-study-status {
    color: #6a9eff;
    background: rgba(90, 142, 255, 0.08);
    border-color: rgba(106, 158, 255, 0.3);
  }

  .project-link::before {
    content: "";
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--work-border-angle),
      rgba(42, 82, 204, 0.2),
      #5a8eff,
      rgba(42, 82, 204, 0.2) 35%,
      rgba(42, 82, 204, 0.2) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }

  .project-link:hover,
  .project-link:focus-visible {
    color: #ffffff;
    border-color: transparent;
    box-shadow: none;
  }

  html:not(.dark) .project-link {
    color: #343b45;
    background: rgba(223, 226, 227, 0.82);
    border-color: rgba(42, 82, 204, 0.35);
  }

  html:not(.dark) .project-link-icon {
    filter: brightness(0) saturate(100%) invert(23%) sepia(9%) saturate(638%);
  }

  .project-link:hover::before,
  .project-link:focus-visible::before {
    opacity: 1;
    animation: work-border-travel 2.4s linear infinite;
  }

  .project-link-lab-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 4px;
  }

  .project-link-icon {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .project-link:focus-visible {
    outline: 2px solid #6a9eff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .slice:hover::before,
    .slice:focus-visible::before,
    .project-link:hover::before,
    .project-link:focus-visible::before {
      animation: none;
      background: #5a8eff;
    }
  }

  .slice-eyebrow {
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
