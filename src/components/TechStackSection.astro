---
export interface Props { heading?: string; }
const { heading = "Skills & Tools" } = Astro.props;
const groups = [
  { title: "Design & interfaces", description: "I connect visual design with working interfaces.", skills: ["Interface design", "Responsive layouts", "User flows", "Design tokens", "Reusable components", "Adobe XD"] },
  { title: "Frontend", description: "Tools used across my web projects.", skills: ["HTML & CSS", "JavaScript", "TypeScript", "React", "Next.js", "Astro", "Vue", "Tailwind CSS"] },
  { title: "Testing & accessibility", description: "Web testing experience; native mobile automation is my next learning focus.", skills: ["Vitest", "Playwright", "axe", "Lighthouse", "Contrast checking", "Manual iOS & Android testing"] },
  { title: "Mobile & delivery", description: "Building apps, connecting data, and deploying projects.", skills: ["Expo", "React Native", "Cloudflare Workers", "D1", "Sanity", "Git", "Vercel"] },
];
---
<section class="techstack" id="techstack-section" aria-labelledby="techstack-title">
  <header class="techstack-header">
    <h2 id="techstack-title">{heading}</h2>
    <p>Design, frontend development, and testing—supported by the projects above.</p>
  </header>
  <div class="skills-grid">
    {groups.map(group => <section class="skill-group">
      <h3>{group.title}</h3>
      <p>{group.description}</p>
      <ul>{group.skills.map(skill => <li>{skill}</li>)}</ul>
    </section>)}
  </div>
</section>
<style>
  .techstack { padding: 3rem 6% 6rem; background: #dfe2e3; color: #343b45; }
  :global(.dark) .techstack { background: #0a0e17; color: #eef4ff; }
  h2 { margin: 0; font: 700 clamp(2.1rem, 4.4vw, 3.4rem)/1.05 "DM Sans", sans-serif; letter-spacing: -.02em; }
  .techstack-header > p { max-width: 60ch; margin: 1.25rem 0 2rem; line-height: 1.7; }
  .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .skill-group { padding: 1.5rem; border: 1px solid #929ba2; border-radius: 6px; }
  :global(.dark) .skill-group { background: #12161f; border-color: #33445e; }
  h3 { margin: 0; font: 600 1.2rem/1.4 "DM Sans", sans-serif; }
  .skill-group p { line-height: 1.6; max-width: 55ch; }
  ul { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  li { padding: .45rem .65rem; border: 1px solid #7a879a; border-radius: 4px; font: 500 .8rem/1.4 "Azeret Mono", monospace; }
  :global(.dark) li { color: #c7dbff; border-color: #445a79; }
  @media(max-width: 680px) { .techstack { padding: 2rem 1.4rem 4rem; } .skills-grid { grid-template-columns: 1fr; } }
</style>
