---
// Experiments that are still in progress. Kept out of the main Selected Works grid.
const labs = [
  {
    title: "09 Labs",
    eyebrow: "SNIPPET LIBRARY · IN DEVELOPMENT",
    summary:
      "A snippet vault and small design system. Save code snippets, group them, and switch between three themes. Still in development.",
    caseStudy: "/lab/09labs",
    githubUrl: "https://github.com/DeafGecko/09-labs-snippet",
    websiteUrl: "https://09-labs-snippet-zeta.vercel.app",
  },
  {
    title: "Kanso",
    eyebrow: "MINIMALIST WRITING APP",
    summary: "A distraction-free writing app.",
    githubUrl: "https://github.com/DeafGecko/kanso-2.0",
    websiteUrl: "https://kanso.09labs.dev",
  },
  {
    title: "Monolith",
    eyebrow: "EXPERIMENT",
    summary: "A demo online store.",
    githubUrl: "https://github.com/DeafGecko/swiss-ecommerce/tree/main/swiss-ecommerce",
    websiteUrl: "https://ecommerce.09labs.dev",
  },
  {
    title: "Quality Lab",
    eyebrow: "TEST DASHBOARD · LIVE",
    summary:
      "A dashboard that shows the automated test results for my apps in one place. Open the website, or the app being tested.",
    image: "/brand/lab-icon.png",
    websiteUrl: "https://lab.09folio.com",
  },
];
---

<section class="labs" id="labs-section" aria-labelledby="labs-title">
  <header class="labs-header">
    <h2 class="labs-title" id="labs-title">Labs / Experiments</h2>
    <p class="labs-intro">Work in progress that shows how I think about components and reuse.</p>
  </header>

  <ul class="labs-list">
    {
      labs.map((lab) => (
        <li class="labs-card">
          <p class="labs-eyebrow">{lab.eyebrow}</p>
          <div class="labs-name-row">
            {lab.image && <img class="labs-image" src={lab.image} alt="" width="36" height="36" aria-hidden="true" />}
            <h3 class="labs-name">{lab.title}</h3>
          </div>
          <p class="labs-summary">{lab.summary}</p>
          <div class="labs-links">
            {lab.caseStudy && (
            <a class="lab-btn lab-btn-text" href={lab.caseStudy}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h4"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <circle cx="17.5" cy="17.5" r="2.5"></circle>
                <path d="M21 21l-1.2-1.2"></path>
              </svg>
              <span>Case Study</span>
            </a>
            )}
{lab.githubUrl && (
              <a class="lab-btn" href={lab.githubUrl} target="_blank" rel="noopener" aria-label="View on GitHub" title="View on GitHub">
              <img src="/github.svg" alt="" width="18" height="18" aria-hidden="true" />
            </a>
            )}
            <a class="lab-btn" href={lab.websiteUrl} target="_blank" rel="noopener" aria-label="Quality Lab website" title="Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20"></path>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .labs {
    padding: 4rem 6% 5rem;
    background: #dfe2e3;
  }
  :global(.dark) .labs {
    background: #0a0e17;
  }
  .labs-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }
  .labs-intro {
    margin: 0.75rem 0 2rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  .labs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .labs-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .labs-name-row .labs-name {
    margin: 0;
  }
  .labs-image {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
  }
  .labs-card {
    padding: 1.5rem;
    border: 1px solid #929ba2;
    border-radius: 6px;
  }
  :global(.dark) .labs-card {
    background: #12161f;
    border-color: #33445e;
  }
  .labs-eyebrow {
    margin: 0;
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #2a52cc;
  }
  :global(.dark) .labs-eyebrow {
    color: #6a9eff;
  }
  .labs-name {
    margin: 0.4rem 0 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.4rem;
  }
  .labs-summary {
    margin: 0.5rem 0 0;
    line-height: 1.6;
  }
  .labs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .labs-links {
    align-items: center;
  }
  .lab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: #eef4ff;
    background: #0a0e17;
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    text-decoration: none;
  }
  .lab-btn-text {
    width: auto;
    padding: 0 1rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .lab-btn img {
    filter: brightness(0) invert(1);
  }
  .lab-btn:hover,
  .lab-btn:focus-visible {
    border-color: #6a9eff;
  }
</style>
