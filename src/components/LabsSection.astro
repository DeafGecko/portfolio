---
// Experiments that are still in progress. Kept out of the main Selected Works grid.
const labs = [
  {
    title: "09 Labs",
    eyebrow: "IN DEVELOPMENT",
    tags: ["Next.js", "React", "TypeScript", "Tailwind CSS"],
    summary:
      "A snippet vault and small design system. Save code snippets, group them, and switch between three themes. Still in development.",
    caseStudy: "/lab/09labs",
    githubUrl: "https://github.com/DeafGecko/09-labs-snippet",
    websiteUrl: "https://09-labs-snippet-zeta.vercel.app",
    preview: "/images/09labs-mockup.png",
    shows: "component reuse and design systems",
  },
  {
    title: "Kanso",
    eyebrow: "LIVE",
    tags: ["React", "TypeScript", "Vite", "Tailwind CSS"],
    summary: "A distraction-free writing app.",
    caseStudy: "/lab/kanso",
    githubUrl: "https://github.com/DeafGecko/kanso-2.0",
    websiteUrl: "https://kanso.09labs.dev",
    labUrl: "https://lab.09folio.com",
    preview: "/images/Kanso01.png",
    shows: "focused interface design and accessibility checks",
  },
  {
    title: "Monolith",
    eyebrow: "EXPERIMENT",
    tags: ["Next.js", "React", "Prisma", "Zustand", "Tailwind CSS"],
    summary: "A demo online store.",
    caseStudy: "/lab/monolith",
    githubUrl: "https://github.com/DeafGecko/swiss-ecommerce/tree/main/swiss-ecommerce",
    websiteUrl: "https://ecommerce.09labs.dev",
    preview: "/images/monolith-mockup.png",
    shows: "a complete store flow, from browsing to checkout",
  },
  {
    title: "Quality Lab",
    eyebrow: "LIVE",
    tags: ["Next.js", "TypeScript", "GitHub Actions"],
    summary:
      "A dashboard that shows the automated test results for my apps, including the other labs above. Open the website, or the app being tested.",
    image: "/brand/lab-icon.png",
    caseStudy: "/lab/quality-lab",
    websiteUrl: "https://lab.09folio.com",
    shows: "automated testing and CI results in one dashboard",
  },
];
---

<section class="labs" id="labs-section" aria-labelledby="labs-title">
  <header class="labs-header">
    <h2 class="labs-title" id="labs-title">Labs / Experiments</h2>
    <p class="labs-intro">Work in progress that shows how I think about components and reuse.</p>
  </header>

  <ul class="labs-list">
    {
      labs.map((lab) => (
        <li class="labs-card">
          {lab.preview && <img class="labs-preview" src={lab.preview} alt="" width="800" height="500" loading="lazy" aria-hidden="true" />}
          <p class="labs-eyebrow">{lab.eyebrow}</p>
          <div class="labs-name-row">
            {lab.image && <img class="labs-image" src={lab.image} alt="" width="36" height="36" aria-hidden="true" />}
            <h3 class="labs-name">{lab.title}</h3>
          </div>
          <p class="labs-summary">{lab.summary}</p>
          <p class="labs-shows"><span>Shows:</span> {lab.shows}</p>
          <ul class="labs-tags" aria-label="Tools">
            {lab.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <div class="labs-links">
            {lab.caseStudy && (
            <a class="lab-btn lab-btn-text" href={lab.caseStudy}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h4"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <circle cx="17.5" cy="17.5" r="2.5"></circle>
                <path d="M21 21l-1.2-1.2"></path>
              </svg>
              <span>Case Study</span>
            </a>
            )}
{lab.githubUrl && (
              <a class="lab-btn" href={lab.githubUrl} target="_blank" rel="noopener" aria-label="View on GitHub" title="View on GitHub">
              <img src="/github.svg" alt="" width="18" height="18" aria-hidden="true" />
            </a>
            )}
            <a class="lab-btn" href={lab.websiteUrl} target="_blank" rel="noopener" aria-label="Quality Lab website" title="Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20"></path>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </a>
            {lab.labUrl && (
              <a class="lab-btn" href={lab.labUrl} target="_blank" rel="noopener" aria-label="Open in Quality Lab" title="Quality Lab">
                <img class="lab-btn-lab-icon" src="/brand/lab-icon.png" alt="" width="28" height="28" aria-hidden="true" />
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .labs {
    padding: 4rem 6% 5rem;
    background: #dfe2e3;
  }
  :global(.dark) .labs {
    background: #0a0e17;
  }
  .labs-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }
  .labs-intro {
    margin: 0.75rem 0 2rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  .labs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .labs-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .labs-name-row .labs-name {
    margin: 0;
  }
  .labs-image {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
  }
  .labs-card {
    padding: 1.5rem;
    border: 1px solid #929ba2;
    border-radius: 6px;
  }
  :global(.dark) .labs-card {
    background: #12161f;
    border-color: #33445e;
  }
  .labs-eyebrow {
    margin: 0;
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #2a52cc;
  }
  :global(.dark) .labs-eyebrow {
    color: #6a9eff;
  }
  .labs-name {
    margin: 0.4rem 0 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.4rem;
  }
  .labs-summary {
    margin: 0.5rem 0 0;
    line-height: 1.6;
  }
  .labs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .labs-links {
    align-items: center;
  }
  .lab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: #6a9eff;
    background: #0a0e17;
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    text-decoration: none;
  }
  .lab-btn-text {
    width: auto;
    padding: 0 1rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.95rem;
    font-weight: 600;

    color: #ffffff;
  }
  .lab-btn img:not(.lab-btn-lab-icon) {
    filter: brightness(0) invert(1);
  }
  .lab-btn-lab-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 4px;
  }
  .lab-btn:hover,
  .lab-btn:focus-visible {
    border-color: #6a9eff;
  }
  @media (max-width: 960px) {
    .labs-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .labs-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .labs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
  }
  .labs-tags li {
    padding: 0.3rem 0.55rem;
    border: 1px solid #7a879a;
    border-radius: 4px;
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 500;
  }
  :global(.dark) .labs-tags li {
    color: #c7dbff;
    border-color: #445a79;
  }
  .labs-preview {
    display: block;
    width: calc(100% + 3rem);
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: -1.5rem -1.5rem 1rem;
    border-radius: 6px 6px 0 0;
  }
  .labs-shows {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(214, 230, 255, 0.8);
  }
  .labs-shows span {
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #6a9eff;
  }
  html:not(.dark) .labs-shows {
    color: rgba(52, 59, 69, 0.85);
  }
</style>
