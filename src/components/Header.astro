---
import ThemeToggle from "./ThemeToggle";
import NavMenu from "./NavMenu.astro"; // ← explicit .astro extension
import MobileMenu from "./MobileMenu";
import ContactButton from "./ContactButton";
---

<header class="site-header sticky top-0 z-50" data-site-header>
  <div class="max-w-9xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid h-16 grid-cols-[1fr_auto] items-center md:grid-cols-[1fr_auto_1fr]"
    >
      <!-- Left: Logo -->
      <div class="flex items-center justify-self-start">
        <a
          href="#hero-section"
          aria-label="Back to hero section"
          class="brand-link group"
        >
          <span class="brand-wordmark">
            <span class="brand-num">09</span><span class="brand-name">Folio</span>
          </span>
        </a>
      </div>

      <!-- Center: Desktop navigation -->
      <NavMenu />

      <!-- Right: Hamburger + desktop contact + toggle -->
      <div
        class="flex items-center justify-self-end space-x-2 md:space-x-4 flex-nowrap"
      >
        <!-- Mobile hamburger (hidden on desktop) -->
        <div class="md:hidden">
          <MobileMenu client:load />
        </div>

        <!-- Contact button (large desktop only) -->
        <div class="hidden xl:block">
          <ContactButton />
        </div>

        <!-- Theme toggle (always visible) -->
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(223, 226, 227, 0.82);
    box-shadow: 0 8px 30px rgba(26, 42, 74, 0.06);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    transform: translateY(0);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
    will-change: transform;
  }

  :global(.dark) .site-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background: rgba(10, 14, 23, 0.68);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  }

  .site-header[data-hidden="true"] {
    transform: translateY(calc(-100% - 1px));
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.5rem;
    text-decoration: none;
  }

  .brand-link:focus-visible {
    outline: 2px solid #5a8eff;
    outline-offset: 2px;
  }

  .brand-wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    font-family: "DM Sans", sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .brand-num {
    color: #2a52cc;
    transition: color 0.2s ease;
  }

  .brand-name {
    color: #343b45;
    transition: color 0.2s ease;
  }

  :global(.dark) .brand-num {
    color: #5a8eff;
  }

  :global(.dark) .brand-name {
    color: #eef4ff;
  }

  .group:hover .brand-num {
    color: #1a3aab;
  }

  .group:hover .brand-name {
    color: #1e2530;
  }

  :global(.dark) .group:hover .brand-num {
    color: #8ab4ff;
  }

  :global(.dark) .group:hover .brand-name {
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script is:inline>
  const header = document.querySelector("[data-site-header]");
  const themeToggle = document.querySelector("[data-theme-toggle]");

  const syncThemeToggle = () => {
    if (!themeToggle) return;
    const isDark = document.documentElement.classList.contains("dark");
    themeToggle.setAttribute("aria-checked", String(isDark));
    themeToggle.setAttribute(
      "aria-label",
      `Switch to ${isDark ? "light" : "dark"} mode`,
    );
  };

  syncThemeToggle();

  themeToggle?.addEventListener("click", () => {
    const nextIsDark = !document.documentElement.classList.contains("dark");
    document.documentElement.classList.toggle("dark", nextIsDark);
    localStorage.setItem("09labs-theme", nextIsDark ? "dark" : "light");

    const themeColor = document.querySelector('meta[name="theme-color"]');
    themeColor?.setAttribute("content", nextIsDark ? "#0a0e17" : "#dfe2e3");
    syncThemeToggle();
  });

  if (header) {
    header.dataset.hidden = "false";
    let previousY = window.scrollY;

    const updateHeader = () => {
      const currentY = window.scrollY;
      const delta = currentY - previousY;

      if (currentY <= 80 || delta < -1) {
        header.dataset.hidden = "false";
      } else if (delta > 1) {
        header.dataset.hidden = "true";
      }

      previousY = currentY;
    };

    window.addEventListener("scroll", updateHeader, { passive: true });
  }
</script>
